# ---------------------------------------------------------------------------
# The PostgreSQL databases of the services: one database and one IAM-authenticated user per service and
# environment (accounts_staging owned by agripulse_accounts_staging, ...), created by a Job in the cluster
# (RDS is private: nothing outside the VPC can reach it). Idempotent: run again whenever the list changes.
#
#   - the user logs in with IAM tokens only (rds_iam), never a password
#   - the user owns its database; CONNECT and TEMPORARY are revoked from PUBLIC, so no other service's user can
#     even open it
#   - the master password stays in Secrets Manager: the Job's own Pod Identity role reads it (infra/aws)
# Terraform waits for the Job (a Helm hook), so Argo CD only syncs the services once their databases exist.
# ---------------------------------------------------------------------------

locals {
  # Names are validated in variables.tf (lowercase letters, digits, _), so they can be written into the SQL as is
  sql = join("\n", concat(["-- generated by infra/modules/k8s-database"], flatten([
    for k, d in var.databases : [
      "DO $$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${d.user}') THEN CREATE ROLE ${d.user} LOGIN; END IF; END $$;",
      "GRANT rds_iam TO ${d.user};",
      "GRANT ${d.user} TO :\"master\";", # the master may then create a database owned by the user
      "SELECT 'CREATE DATABASE ${d.name} OWNER ${d.user}' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${d.name}') \\gexec",
      "ALTER DATABASE ${d.name} OWNER TO ${d.user};",
      "REVOKE CONNECT, TEMPORARY ON DATABASE ${d.name} FROM PUBLIC;",
      "GRANT CONNECT ON DATABASE ${d.name} TO ${d.user};",
      "\\echo '${d.name}: owned by ${d.user} (IAM authentication)'",
    ]
  ])))
}

# The RDS CA bundle: psql verifies the database's certificate (verify-full). Pinned by checksum.
data "http" "rds_ca" {
  url = "https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem"

  lifecycle {
    postcondition {
      condition     = sha256(self.response_body) == var.rds_ca_sha256
      error_message = "The RDS CA bundle changed: check https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL.html and update rds_ca_sha256 (also in app/Dockerfile)."
    }
  }
}

resource "kubernetes_namespace_v1" "this" {
  metadata {
    name = "db-bootstrap"
    labels = {
      "pod-security.kubernetes.io/enforce" = "restricted"
      "pod-security.kubernetes.io/audit"   = "restricted"
    }
  }
}

resource "helm_release" "bootstrap" {
  name          = "db-bootstrap"
  chart         = "${path.module}/chart"
  namespace     = kubernetes_namespace_v1.this.metadata[0].name
  wait          = true
  wait_for_jobs = true
  timeout       = 600

  values = [yamlencode({
    image           = var.image
    region          = var.region
    masterSecretArn = var.master_secret_arn
    db              = { host = var.db_host, port = var.db_port }
    sql             = local.sql
    caBundle        = data.http.rds_ca.response_body
  })]
}
