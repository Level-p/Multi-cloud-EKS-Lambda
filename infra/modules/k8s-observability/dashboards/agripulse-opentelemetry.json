{
 "uid": "agripulse-otel",
 "title": "AgriPulse services (OpenTelemetry)",
 "description": "RED metrics from Tempo span metrics, the service map, failed traces and error logs. Traces and logs come from the apps through the OpenTelemetry Collector.",
 "tags": [
  "agripulse",
  "opentelemetry"
 ],
 "timezone": "browser",
 "editable": false,
 "refresh": "30s",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(traces_spanmetrics_calls_total, service)",
     "refId": "service"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": "agripulse-web|incident-blog",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__rate_interval]))",
     "legendFormat": "{{service}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error ratio (server spans with status ERROR)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__rate_interval]))",
     "legendFormat": "{{service}}"
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency (click a dot: exemplar trace)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__rate_interval])))",
     "legendFormat": "{{service}}",
     "exemplar": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "nodeGraph",
   "title": "Service map (from traces)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "serviceMap"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 10
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Slowest operations (p95, last 15 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, service, span_kind, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[15m]))))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "p95"
      }
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "table",
   "title": "Recent failed traces",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "limit": 20,
     "query": "{ resource.service.namespace = \"agripulse\" && status = error }"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 10
   }
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Warnings and errors (click a line: its trace)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"$service\"} | severity_text=~\"WARN.*|ERROR|CRITICAL\""
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 10
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}
