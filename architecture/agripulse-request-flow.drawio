<mxfile host="drawio" type="device"><diagram id="AgriPulse request flow" name="AgriPulse request flow"><mxGraphModel dx="2200" dy="1330" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AgriPulse: one request through each path, and the check at every hop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="c3" value="A request that fails a check stops there and never reaches the next hop. Both paths end at the same services, each with its own database and PostgreSQL user." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2000" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Mobile API · example: POST /orders (a buyer orders tomatoes from a farm in the app)" style="rounded=1;arcSize=3;fillColor=#F7FBFF;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#0078D4;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="2140" height="520" as="geometry"/></mxCell><mxCell id="c5" value="Buyer (mobile app)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.mobile_client;" vertex="1" parent="1"><mxGeometry x="155" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;token from POST /auth/token&lt;br&gt;(accounts, Argon2, lockout);&lt;br&gt;valid 8 h, sent as Bearer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c7" value="Route 53 + ACM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;api.mfon21.space -&gt; the API&#x27;s&lt;br&gt;custom domain; TLS 1.2+;&lt;br&gt;execute-api URL switched off&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c9" value="AWS WAF" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="845" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;on the API stage: SQL injection,&lt;br&gt;common exploits, bad inputs,&lt;br&gt;bad IPs, bots, rate limit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c11" value="API Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="1190" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;throttling 50 rps / burst 100;&lt;br&gt;access logs (no bodies)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c13" value="Lambda gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1535" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;route in the list? (404)&lt;br&gt;body over 64 KB? (413)&lt;br&gt;query over 500 chars? (414)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1465" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c15" value="shop-production" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;align=center;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1880" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;via the ALB + WAF:&lt;br&gt;token signed by accounts? (401)&lt;br&gt;buyer or farmer? (403) stock? (409)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1810" y="285" width="200" height="150" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Answers on the way back:&lt;/b&gt; 201 one order per farm · 400/422 invalid body (says which field) · 401 no or bad token · 403 blocked by WAF or the wrong role · 404 unknown route or someone else&#x27;s order · 409 not enough in stock · 413 body over 64 KB · 429 rate limit · 503 a service is down, never with internal details" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="2080" height="50" as="geometry"/></mxCell><mxCell id="c23" value="Web · example: POST /checkout on shop.mfon21.space (a buyer places the order in the cart)" style="rounded=1;arcSize=3;fillColor=#F7FBFF;strokeColor=#ED7100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#ED7100;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="2140" height="520" as="geometry"/></mxCell><mxCell id="c24" value="Browser" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="155" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;session cookie: HttpOnly, Secure,&lt;br&gt;SameSite=Lax; CSRF token in&lt;br&gt;the form; strict CSP, no scripts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c26" value="Route 53 + ACM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="500" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;shop.mfon21.space -&gt; the ALB;&lt;br&gt;wildcard certificate,&lt;br&gt;TLS 1.2+&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c28" value="AWS WAF" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="845" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;the same web ACL, on the ALB:&lt;br&gt;SQL injection, exploits, bots,&lt;br&gt;rate limit; scripted sign-in blocked&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c30" value="ALB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1"><mxGeometry x="1190" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;HTTPS (port 80 redirects);&lt;br&gt;host rule -&gt; shop-production;&lt;br&gt;unknown host -&gt; 404&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c32" value="shop (EKS)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;align=center;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1535" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;NetworkPolicy: ALB, Prometheus;&lt;br&gt;token + role; CSRF token;&lt;br&gt;validated form; cart in Redis&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1465" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c34" value="farm (internal API)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;align=center;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1880" y="710" width="60" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;NetworkPolicy: shop namespace;&lt;br&gt;internal token + no X-Forwarded-For&lt;br&gt;(404); atomic reserve (409)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1810" y="835" width="200" height="150" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Defence in depth:&lt;/b&gt; each layer would still protect the data if the one before it were misconfigured. The ALB&#x27;s own DNS name -&gt; 404 · the execute-api URL is switched off · /internal/ from the internet -&gt; 404, even with the token · a forged token -&gt; wrong signature (each environment has its own key) · SQL injection past the WAF -&gt; bound parameters, and the user can only open its own database · script in a listing -&gt; escaped + CSP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="2080" height="66" as="geometry"/></mxCell><mxCell id="c42" value="Each service signs in to PostgreSQL with an IAM token as its own user (agripulse_shop_production...), over TLS. If any item cannot be reserved, the shop releases what it already reserved and orders nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="2080" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>