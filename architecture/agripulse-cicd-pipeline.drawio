<mxfile host="drawio" type="device"><diagram id="AgriPulse CI/CD pipelines" name="AgriPulse CI/CD pipelines"><mxGraphModel dx="2180" dy="1830" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2180" pageHeight="1830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AgriPulse: GitHub Actions pipelines, OIDC to AWS, GitOps with Argo CD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Each workflow runs when its folders change. Pull requests run the checks only; main also deploys after approval. app builds the changed services (one job each) and deploys them to staging; promote commits staging&#x27;s images for production, you press SYNC. Every workflow ends with an AI diagnosis when something failed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2000" height="24" as="geometry"/></mxCell><mxCell id="c4" value="infra-aws.yml · infra/aws/**, infra/modules/* (not k8s-*) · stack 1" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8C4FFF;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="2120" height="250" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Security scans&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;Gitleaks · Semgrep&lt;br&gt;Checkov (Terraform)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry 