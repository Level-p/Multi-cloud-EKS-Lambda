;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="platform.yml · infra/platform/**, infra/modules/k8s-* · stack 2 (reads stack 1&#x27;s state)" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#5A30B5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#5A30B5;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="2120" height="250" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Security scans&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;Gitleaks · Semgrep&lt;br&gt;Checkov&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="195" height="116" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;OIDC login&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;same IAM role&lt;br&gt;(EKS access entry)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="288" y="430" width="195" height="116" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;init · fmt · validate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;remote state of&lt;br&gt;infra/aws&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontSize=13;fontColor=#1D2433;align